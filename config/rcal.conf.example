
#Updated the scheme: day colors now persist under both current-day and selected-day highlights.
#Weekend/holiday text remains red.
#Current day uses the blue background.
#Selected day uses the yellow background and bold emphasis.
#If current and selected are the same day, yellow selection wins.
#I also changed the example highlight settings to default,blue and default,yellow,bold, since highlight foregrounds are intentionally preserved from the normal day style. Updated [renderer (line 249)](/home/jole/projects/r-cal/src/RCalHeaderFramework.cpp:249), [config (line 35)](/home/jole/projects/r-cal/config/rcal.conf.example:35), and [README (line 59)](/home/jole/projects/r-cal/README.md:59).
#Debug and Release tests pass.


# Timeline range and layout
start_date=today
buffer_days=90
rebuild_threshold_days=30
cell_width=5
show_grid=true
holiday_country=NO

# Localization. Lists require 12 months and 7 days (Monday first).
month_names=Januar,Februar,Mars,April,Mai,Juni,Juli,August,September,Oktober,November,Desember
day_names=Man,Tir,Ons,Tor,Fre,Lør,Søn

label.year=Year
label.month=Month
label.week=Week
label.day_of_year=DOY
label.date=Date
label.day=Day
label.time_info=Info
label.details=Detail
label.holiday_info=Helligdag

# Syntax: foreground,background[,bold][,underline][,reverse]
# Use basic color names or numeric IDs supported by the terminal.
color.label=white,default,bold
color.year=cyan,default
color.month=yellow,default,bold
color.week_number=green,default
color.day_of_year=cyan,default
color.date=white,default
color.day_name=white,default
color.weekend=red,default
color.holiday=red,default,bold

# Current and selected highlights keep the ordinary day foreground. Their
# background and attributes distinguish the highlighted cell.
color.current_day=black,blue

color.selected_day=black,yellow,bold

color.time_info=magenta,default
color.grid=blue,default
